# Keep text LF in the repo. Windows checkouts that convert scripts to CRLF
# make bash fail with $'\r' errors, including under WSL.
* text=auto eol=lf

# Shell scripts
*.sh text eol=lf
gradlew text eol=lf

# Windows command scripts
*.bat text eol=crlf
*.cmd text eol=crlf
gradlew.bat text eol=crlf

# Binaries
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.zip binary
*.gz binary
*.class binary
*.dll binary
*.exe binary
*.so binary
